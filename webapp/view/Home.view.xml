<mvc:View controllerName="com.bootcamp.sapui5.freestyle.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    >
    <Page id="page" title="{i18n>title}">
        <VBox id="vbId01" class="sapUiSmallMargin">
            <Text id="txtId01" text="{i18n>textPruebai18n}" />
        </VBox>
        
        <Toolbar>
            <Input id="idLabel1" value="{LocalDataModel>/valueInput}"></Input><!-- change=".onChange" -->
            <ComboBox
                id="comboboxID"
                selectionChange=".onSelectionChange"
                selectedKey="{LocalDataModel>/selectedKey}"
				items="{
					path: '/Categories',
					sorter: { path: 'CategoryName' }
				}">
				<core:Item key="{CategoryID}" text="{CategoryID}-{CategoryName}" />
			</ComboBox>
            <Button id="btSearch" text="{i18n>textButton}" press="onPress"></Button>
        </Toolbar>
        

		<VBox class="sapUiSmallMargin">
			<Table id="idProductsTable" items="{ProductCollection>/}">
                <columns>
                    <Column width="12em">
                        <Text text="{i18n>Product}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                        <Text text="{i18n>UnitsInStock}" />
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true" hAlign="End">
                        <Text text="{i18n>QuantityPerUnit}" />
                    </Column>
                    <Column hAlign="End">
                        <Text text="{i18n>CategoryID}" />
                    </Column>
                    <Column hAlign="End">
                        <Text text="{i18n>UnitPrice}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle" type="Active" press="onItemPress">
                        <cells>
                            <ObjectIdentifier title="{ProductCollection>ProductID}" text="{ProductCollection>ProductName}" />
                            <Text text="{ProductCollection>UnitsInStock}" />
                            <Text text="{ProductCollection>QuantityPerUnit}" />
                            <Text text="{ProductCollection>CategoryID}" />
                            <ObjectNumber
							number="{
								parts:[{path:'ProductCollection>UnitPrice'}],
								type: 'sap.ui.model.type.Currency',
								formatOptions: {showMeasure: false}
							}"
                            unit="USD" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>			
        </VBox>
        
        <footer>
			<Bar>
				<contentRight>
                    <Button
                        id="btConfirm"
                        type="Emphasized"
                        text="Confirm"
                        press=".onConfirmationMessageBoxPress"
                        width="280px"
                        />
                </contentRight>
			</Bar>
		</footer>
        
    </Page>
</mvc:View>